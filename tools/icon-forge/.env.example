# Не коммить этот файл. Скопируй его в .env и вставь свой ключ.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# По умолчанию deepseek-flash в режиме размышления: он лучше держит геометрию.
# deepseek-chat — тот же тариф, но без размышления: быстрее и больше невнятных росчерков.
# ICON_FORGE_MODEL=deepseek-flash
