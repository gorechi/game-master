# Не коммить этот файл. Скопируй его в .env и вставь свой ключ.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# По умолчанию deepseek-reasoner: он заметно лучше держит геометрию.
# deepseek-chat быстрее, но чаще рисует невнятные росчерки.
# ICON_FORGE_MODEL=deepseek-reasoner
