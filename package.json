{
  "name": "game-master",
  "version": "1.4.0",
  "description": "Настольный помощник мастера для ведения партий D&D",
  "private": true,
  "license": "MIT",
  "author": "Game Master",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "icons": "node scripts/generate-icon.mjs",
    "icons:validate": "node tools/icon-forge/validate.mjs",
    "icons:preview": "node tools/icon-forge/preview.mjs",
    "icons:generate": "node --env-file-if-exists=tools/icon-forge/.env tools/icon-forge/generate.mjs",
    "icons:ui": "node --env-file-if-exists=tools/icon-forge/.env tools/icon-forge/server.mjs",
    "presets:build": "node scripts/build-preset-icons.mjs",
    "presets:check": "node scripts/build-preset-icons.mjs --check",
    "i18n:check": "node scripts/check-locales.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.0"
  }
}
